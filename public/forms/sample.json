{
  "id": "registration",
  "apiBase": "/api",
  "resumeColumn": "phone",
  "dir": "rtl",
  "pages": [
    {
      "id": "identity",
      "title": "اطلاعات فردی",
      "description": "نام و مشخصات خود را وارد کنید. می‌توانید بعداً برگردید و آن‌ها را ویرایش کنید.",
      "items": [
        {
          "type": "typography",
          "variant": "p",
          "text": "فیلدهایی که با ستاره مشخص شده‌اند الزامی هستند.",
          "color": "#666666"
        },
        {
          "type": "text",
          "name": "firstname",
          "label": "نام",
          "minLength": 2,
          "maxLength": 40,
          "rules": [
            {
              "type": "required"
            },
            {
              "type": "persianName",
              "message": "نام را با حروف فارسی بنویسید."
            }
          ],
          "errorMessage": "نام را وارد کنید.",
          "errorMessages": {
            "persianName": "نام را با حروف فارسی بنویسید.",
            "length": "نام باید بین ۲ تا ۴۰ حرف باشد."
          }
        },
        {
          "type": "text",
          "name": "lastname",
          "label": "نام خانوادگی",
          "minLength": 2,
          "maxLength": 50,
          "rules": [
            {
              "type": "required"
            },
            {
              "type": "chars",
              "chars": "ابپتثجچحخدذرزژسشصضطظعغفکگقلمنوهیئيؤآ ",
              "message": "نام خانوادگی را با حروف فارسی بنویسید."
            }
          ],
          "errorMessage": "نام خانوادگی را وارد کنید.",
          "errorMessages": {
            "chars": "نام خانوادگی را با حروف فارسی بنویسید.",
            "length": "نام خانوادگی باید بین ۲ تا ۵۰ حرف باشد."
          }
        },
        {
          "type": "typography",
          "variant": "h2",
          "text": "{{firstname}} عزیز، خوش آمدید",
          "color": "#0065dc",
          "visibleWhen": {
            "field": "firstname",
            "op": "notEmpty"
          }
        },
        {
          "type": "text",
          "name": "phone",
          "label": "شماره موبایل",
          "inputType": "tel",
          "placeholder": "0912...",
          "minLength": 11,
          "maxLength": 11,
          "rules": [
            {
              "type": "required"
            },
            {
              "type": "digits",
              "message": "فقط رقم انگلیسی مجاز است."
            },
            {
              "type": "pattern",
              "value": "^09[0-9]{9}$",
              "message": "شماره باید با ۰۹ شروع شود."
            }
          ],
          "errorMessage": "شماره موبایل را وارد کنید.",
          "errorMessages": {
            "digits": "فقط رقم انگلیسی مجاز است.",
            "length": "شماره باید ۱۱ رقم باشد.",
            "pattern": "شماره باید با ۰۹ شروع شود."
          }
        },
        {
          "type": "radio",
          "name": "gender",
          "label": "جنسیت",
          "required": true,
          "errorMessage": "لطفاً جنسیت را انتخاب کنید.",
          "options": [
            {
              "value": "مرد",
              "label": "مرد"
            },
            {
              "value": "زن",
              "label": "زن"
            }
          ]
        },
        {
          "type": "typography",
          "variant": "span",
          "text": "مدارک هویتی را مطابق جنسیت {{gender}} آماده کنید.",
          "visibleWhen": {
            "field": "gender",
            "op": "notEmpty"
          }
        },
        {
          "type": "agreement",
          "name": "terms",
          "label": "قوانین و شرایط را می‌پذیرم",
          "required": true,
          "errorMessage": "پذیرش قوانین الزامی است.",
          "terms": {
            "title": "قوانین و شرایط",
            "presentation": "static",
            "body": "<p>با ادامه ثبت‌نام می‌پذیرید:</p><ul><li>اطلاعات واردشده برای بررسی درخواست استفاده شود</li><li>تصویر مدارک واضح و متعلق به خودتان باشد</li></ul>"
          },
          "dialogs": {
            "onToggle": {
              "presentation": "alert",
              "title": "تایید پذیرش",
              "body": "آیا از پذیرش قوانین مطمئن هستید؟",
              "confirmText": "بله",
              "cancelText": "خیر"
            }
          }
        }
      ]
    },
    {
      "id": "city",
      "title": "شهر و تاریخ تولد",
      "description": "شهر فعالیت و تاریخ تولد را انتخاب کنید.",
      "beforeNext": {
        "presentation": "sheet",
        "title": "توجه",
        "body": "بعد از این مرحله، مدارک تصویری را بارگذاری می‌کنید.",
        "confirmText": "متوجه شدم",
        "cancelText": "بازگشت"
      },
      "items": [
        {
          "type": "select",
          "name": "city",
          "title": "شهر",
          "required": true,
          "errorMessage": "شهر را انتخاب کنید.",
          "items": [
            {
              "title": "تهران",
              "value": "تهران",
              "items": [
                {
                  "type": "select",
                  "name": "district",
                  "title": "منطقه",
                  "required": true,
                  "errorMessage": "منطقه را انتخاب کنید.",
                  "items": [
                    {
                      "title": "منطقه ۱",
                      "value": "منطقه 1"
                    },
                    {
                      "title": "منطقه ۲",
                      "value": "منطقه 2"
                    },
                    {
                      "title": "منطقه ۳",
                      "value": "منطقه 3"
                    }
                  ]
                }
              ]
            },
            {
              "title": "کرج",
              "value": "کرج"
            },
            {
              "title": "اصفهان",
              "value": "اصفهان"
            }
          ]
        },
        {
          "type": "date",
          "name": "birth_date",
          "title": "تاریخ تولد",
          "dialogTitle": "انتخاب تاریخ تولد",
          "placeholder": "تاریخ را انتخاب کنید",
          "required": true,
          "errorMessage": "تاریخ تولد را انتخاب کنید.",
          "formatMonthPreview": "string",
          "yearRange": {
            "min": 1330,
            "max": 1405
          }
        },
        {
          "type": "radio",
          "name": "need_photos",
          "label": "عکس مدارک را همین حالا می‌فرستید؟",
          "required": true,
          "errorMessage": "یکی از گزینه‌ها را انتخاب کنید.",
          "options": [
            {
              "value": "بله",
              "label": "بله"
            },
            {
              "value": "خیر",
              "label": "خیر"
            }
          ]
        }
      ]
    },
    {
      "id": "documents",
      "title": "مدارک",
      "description": "نوع مدرک را انتخاب کنید و تصویر روی آن را واضح بگیرید.",
      "skipWhen": {
        "field": "need_photos",
        "op": "eq",
        "value": "خیر"
      },
      "items": [
        {
          "type": "stage",
          "name": "doc_type",
          "label": "نوع مدرک",
          "required": true,
          "defaultValue": "کارت",
          "options": [
            {
              "value": "کارت",
              "label": "کارت",
              "items": [
                {
                  "type": "file",
                  "name": "doc_front",
                  "placeholder": "روی کارت",
                  "imagePlaceholder": "/images/icons/dl_fnt.png",
                  "camera": "advanced",
                  "useRear": true,
                  "allowChangeCamera": false,
                  "aspectRatio": "4/3",
                  "required": true,
                  "errorMessage": "تصویر روی کارت الزامی است.",
                  "dialogs": {
                    "onActivate": {
                      "presentation": "alert",
                      "title": "توجه",
                      "body": "مدرک باید کامل در کادر باشد، خوانا باشد و بازتاب نور نداشته باشد.",
                      "confirmText": "متوجه شدم",
                      "cancelText": "انصراف"
                    }
                  }
                },
                {
                  "type": "file",
                  "name": "doc_back",
                  "placeholder": "پشت کارت",
                  "imagePlaceholder": "/images/icons/dl_bck.png",
                  "camera": "advanced",
                  "useRear": true,
                  "allowChangeCamera": false,
                  "required": true,
                  "errorMessage": "تصویر پشت کارت الزامی است."
                }
              ]
            },
            {
              "value": "برگه",
              "label": "برگه",
              "items": [
                {
                  "type": "file",
                  "name": "doc_front",
                  "placeholder": "برگه",
                  "imagePlaceholder": "/images/icons/grn_ppr.png",
                  "camera": "native",
                  "useRear": true,
                  "allowChangeCamera": false,
                  "required": true,
                  "errorMessage": "تصویر برگه الزامی است."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "verify",
      "title": "تصویر و ویدیو",
      "description": "یک عکس پرسنلی و یک ویدیوی کوتاه ضبط کنید.",
      "items": [
        {
          "type": "file",
          "name": "profile_photo",
          "placeholder": "عکس پرسنلی",
          "camera": "native",
          "useRear": false,
          "required": true,
          "errorMessage": "عکس پرسنلی الزامی است.",
          "sources": [
            "camera",
            "gallery"
          ]
        },
        {
          "type": "file",
          "name": "verification_video",
          "placeholder": "ویدیوی احراز هویت",
          "isVideo": true,
          "camera": "advanced",
          "useRear": true,
          "allowChangeCamera": true,
          "aspectRatio": "9/16",
          "width": 1080,
          "height": 1920,
          "maxFileSize": 83886080,
          "required": true,
          "errorMessage": "ویدیوی احراز هویت الزامی است.",
          "captureHintTop": "به دوربین نگاه کنید و متن را بخوانید.",
          "captureHintBottom": "ویدیو باید در فضای باز و با نور کافی باشد.",
          "confirmHintTop": "ویدیو را یک بار ببینید.",
          "dialogs": {
            "onActivate": {
              "presentation": "alert",
              "title": "توجه",
              "body": "قبل از ضبط، لنز دوربین را تمیز کنید و صورتتان کامل در تصویر باشد.",
              "confirmText": "متوجه شدم",
              "cancelText": "انصراف"
            }
          }
        }
      ]
    }
  ]
}
